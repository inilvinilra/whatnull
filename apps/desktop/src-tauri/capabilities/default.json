{
  "identifier": "default",
  "description": "Default permissions for the privileged local shell webview",
  "webviews": [
    "shell"
  ],
  "permissions": [
    "core:default",
    "core:event:default",
    "core:window:default",
    "core:webview:default",
    "core:tray:default",
    "allow-get-app-config",
    "allow-update-app-config",
    "allow-quit-app",
    "allow-get-app-version",
    "allow-get-platform-info",
    "allow-get-startup-status",
    "allow-set-startup-enabled",
    "allow-reload-whatsapp",
    "allow-hard-reload-whatsapp",
    "allow-set-overlay-visible",
    "allow-request-shell-action",
    "allow-reset-session",
    "allow-list-profiles",
    "allow-create-profile",
    "allow-switch-profile",
    "allow-delete-profile",
    "allow-dispatch-notification",
    "allow-strip-file-metadata",
    "allow-inspect-file-metadata"
  ]
}
