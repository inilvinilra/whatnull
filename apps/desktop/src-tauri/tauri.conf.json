{
  "productName": "WhatNull",
  "version": "0.1.0",
  "identifier": "io.whatnull.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build",
    "devUrl": "http://127.0.0.1:1420",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["deb", "rpm", "appimage"],
    "category": "Network",
    "shortDescription": "Open source, Linux-first, secure WhatsApp desktop client",
    "longDescription": "WhatNull is an open source, privacy-first, low-resource WhatsApp desktop client engineered specifically for Linux desktop environments.",
    "copyright": "Copyright (c) 2026 WhatNull Contributors",
    "publisher": "WhatNull Community",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/icon.png"
    ],
    "linux": {
      "deb": {
        "depends": [
          "libwebkit2gtk-4.1-0 | libwebkit2gtk-4.0-37",
          "libgtk-3-0"
        ]
      },
      "rpm": {
        "depends": [
          "webkit2gtk4.1",
          "gtk3"
        ]
      }
    }
  }
}
